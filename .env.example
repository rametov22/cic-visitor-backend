# dev, test, stage, prod
ENVIRONMENT=dev

# Compose
PROJECT_NAME=iccu-visitor
APP_PORT=30311
BACKEND_IMAGE=registry-test.glob.uz/iccu/visitor-backend:latest

# Django
DJANGO_APP_NAME="CIC Visitor"
# Required in stage/prod; generate with: openssl rand -hex 64
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:30311
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:30311
DJANGO_LOG_LEVEL=INFO
NEWS_API_URL=https://example.com

# Monitoring. Generate with: openssl rand -hex 32
DEEP_HEALTH_API_KEY=CHANGE_ME

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30

# PostgreSQL
POSTGRES_DB=iccu_db
POSTGRES_USER=iccu_db_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Static and media are stored in Docker named volumes and served by Nginx.
DJANGO_MEDIA_URL=/media/

# Optional production database backups
# COMPOSE_PROFILES=backup
# DB_BACKUP_INTERVAL=1440
# DB_BACKUP_CLEANUP_TIME=10080
# DB_BACKUP_COMPRESSION=ZSTD
# DB_BACKUP_FS_PATH=./db-backups
